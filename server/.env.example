# Copy to .env for local development. Real values must NEVER be committed.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/CodeCord

# Public URL of the frontend (CORS origin)
CLIENT_URL=http://localhost:5173

# Public base URL of THIS API (used to build local upload URLs)
PUBLIC_URL=http://localhost:5000

# Auth secrets — at least 32 characters each
JWT_ACCESS_SECRET=replace-with-32-plus-random-chars
JWT_REFRESH_SECRET=replace-with-different-32-plus-random-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Cloudinary image storage (required by the env schema)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integrations (endpoints return 503 when unset)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SMTP for verification emails (logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Communo <no-reply@communo.local>
REQUIRE_EMAIL_VERIFICATION=true

# Comma-separated; registration is restricted to these email domains
ALLOWED_EMAIL_DOMAINS=iut-dhaka.edu

# Google Sign-In (browser OAuth client ID only)
GOOGLE_CLIENT_ID=

# Platform admin login (Admin tab: email + secret key)
ADMIN_EMAIL=admin@gmail.com
ADMIN_SECRET_KEY=ad123
