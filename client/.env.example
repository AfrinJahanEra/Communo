# Copy to .env for local development. Real values must NEVER be committed.
# In production these are set in the Vercel project settings.

# REST API base URL
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO server URL (defaults to VITE_API_URL minus the /api path)
VITE_SOCKET_URL=http://localhost:5000

# Google Sign-In browser OAuth client ID
VITE_GOOGLE_CLIENT_ID=

# Optional TURN relay for voice rooms across mobile/symmetric NATs (e.g. metered.ca)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
